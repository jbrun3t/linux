			reg = <0x251b000 0x400>;
			interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_I2C11>;
			resets = <&ccu RST_BUS_I2C11>;
//			dmas = <&dma 60>, <&dma 60>;
//			dma-names = "rx", "tx";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		twi12: i2c@251c000 {
			compatible = "allwinner,sun60i-a733-i2c",
				     "allwinner,sun8i-v536-i2c",
				     "allwinner,sun6i-a31-i2c";
			reg = <0x251c000 0x400>;
			interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_I2C12>;
			resets = <&ccu RST_BUS_I2C12>;
//			dmas = <&dma 61>, <&dma 61>;
//			dma-names = "rx", "tx";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi0: spi@2540000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun55i-a523-spi";
			reg = <0x2540000 0x1000>;
			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI0>, <&ccu CLK_SPI0>;
			clock-names = "ahb", "mod";
			/* dmas = <&dma 23>, <&dma 23>; */
			/* dma-names = "rx", "tx"; */
			resets = <&ccu RST_BUS_SPI0>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi1: spi@2541000 {
			compatible = "allwinner,sun60i-a733-spi-dbi",
				     "allwinner,sun55i-a523-spi-dbi",
				     "allwinner,sun55i-a523-spi";
			reg = <0x2541000 0x1000>;
			interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI1>, <&ccu CLK_SPI1>;
			clock-names = "ahb", "mod";
			/* dmas = <&dma 24>, <&dma 24>; */
			/* dma-names = "rx", "tx"; */
			resets = <&ccu RST_BUS_SPI1>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi2: spi@2542000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun55i-a523-spi";
			reg = <0x2542000 0x1000>;
			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI2>, <&ccu CLK_SPI2>;
			clock-names = "ahb", "mod";
			/* dmas = <&dma 25>, <&dma 25>; */
			/* dma-names = "rx", "tx"; */
			resets = <&ccu RST_BUS_SPI2>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi3: spi@2543000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun55i-a523-spi";
			reg = <0x2543000 0x1000>;
			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI3>, <&ccu CLK_SPI3>;
			clock-names = "ahb", "mod";
			/* dmas = <&dma 26>, <&dma 26>; */
			/* dma-names = "rx", "tx"; */
			resets = <&ccu RST_BUS_SPI3>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi4: spi@2544000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun55i-a523-spi";
			reg = <0x2544000 0x1000>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_SPI4>, <&ccu CLK_SPI4>;
			clock-names = "ahb", "mod";
			/* dmas = <&dma 54>, <&dma 54>; */
			/* dma-names = "rx", "tx"; */
			resets = <&ccu RST_BUS_SPI4>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		gic: interrupt-controller@3400000 {
			compatible = "arm,gic-v3";
			#address-cells = <1>;
			#interrupt-cells = <3>;
			#size-cells = <1>;
			ranges;
			interrupt-controller;
			reg = <0x3400000 0x10000>,
			      <0x3460000 0x100000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			dma-noncoherent;

			/* its: msi-controller@3440000 { */
			/* 	compatible = "arm,gic-v3-its"; */
			/* 	reg = <0x3440000 0x20000>; */
			/* 	msi-controller; */
			/* 	#msi-cells = <1>; */
			/* 	dma-noncoherent; */
			/* }; */
		};

		mmc0: mmc@4020000 {
			compatible = "allwinner,sun60i-a733-mmc",
				     "allwinner,sun20i-d1-mmc";
			reg = <0x4020000 0x1000>;
			clocks = <&ccu CLK_BUS_MMC0>, <&ccu CLK_MMC0>;
			clock-names = "ahb", "mmc";
			resets = <&ccu RST_BUS_MMC0>;
			reset-names = "ahb";
			interrupts = <GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mmc1: mmc@4021000 {
			compatible = "allwinner,sun60i-a733-mmc",
				     "allwinner,sun20i-d1-mmc";
			reg = <0x4021000 0x1000>;
			clocks = <&ccu CLK_BUS_MMC1>, <&ccu CLK_MMC1>;
			clock-names = "ahb", "mmc";
			resets = <&ccu RST_BUS_MMC1>;
			reset-names = "ahb";
			interrupts = <GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mmc2: mmc@4022000 {
			compatible = "allwinner,sun60i-a733-mmc",
				     "allwinner,sun20i-d1-mmc";
			reg = <0x4022000 0x1000>;
			clocks = <&ccu CLK_BUS_MMC2>, <&ccu CLK_MMC2>;
			clock-names = "ahb", "mmc";
			resets = <&ccu RST_BUS_MMC2>;
			reset-names = "ahb";
			interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		gmac0: ethernet@4500000 {
			compatible = "allwinner,sun60i-a733-gmac210",
				     "snps,dwmac-5.20";
			reg = <0x4500000 0x8000>,
			      <0x4508000 0x1000>;
			clocks = <&ccu CLK_BUS_GMAC0>,
			         <&ccu CLK_MBUS_GMAC0>,
				 <&ccu CLK_GMAC_PTP>;
			clock-names = "stmmaceth", "mbus", "ptp_ref";
			resets = <&ccu RST_BUS_GMAC0>,
				 <&ccu RST_BUS_GMAC0_AXI>;
			reset-names = "stmmaceth", "ahb";
			interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_lpi", "tx-queue-0", "rx-queue-0";
			snps,fixed-burst;
			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;
			status = "disabled";

			mdio0: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		gmac1: ethernet@4510000 {
			compatible = "allwinner,sun60i-a733-gmac210",
				     "snps,dwmac-5.20";
			reg = <0x4510000 0x8000>,
			      <0x4518000 0x1000>;
			clocks = <&ccu CLK_BUS_GMAC1>,
				 <&ccu CLK_MBUS_GMAC1>,
				 <&ccu CLK_GMAC_PTP>;
			clock-names = "stmmaceth", "mbus", "ptp_ref";
			resets = <&ccu RST_BUS_GMAC1>,
				 <&ccu RST_BUS_GMAC1_AXI>;
			reset-names = "stmmaceth", "ahb";
			interrupts = <GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 177 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_lpi", "tx-queue-0", "rx-queue-0";
			snps,fixed-burst;
			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;
			status = "disabled";

			mdio1: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		s_prcm: clock-controller@7010000 {
			compatible = "allwinner,sun60i-a733-r-ccu";
			reg = <0x7010000 0x250>;
			clocks = <&hosc>,
				 <&rtc CLK_OSC32K>,
				 <&rtc CLK_IOSC>,
				 <&ccu CLK_SYS_24M>,
				 <&ccu CLK_PLL_PERIPH0_200M>,
				 <&ccu CLK_PLL_PERIPH0_300M>,
				 <&ccu CLK_PLL_PERIPH1_300M>;
			clock-names = "hosc",
				      "losc",
				      "iosc",
				      "sys-24m",
				      "pll-periph0-200m",
				      "pll-periph0-300m",
				      "pll-periph1-300m";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		nmi_intc: interrupt-controller@7010320 {
			compatible = "allwinner,sun60i-a733-nmi",
				     "allwinner,sun55i-a523-nmi";
			reg = <0x07010320 0xc>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;
		};

		s_gpio: pinctrl@7025000 {
			compatible = "allwinner,sun60i-a733-r-pinctrl";
			reg = <0x7025000 0x800>;
			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s_prcm CLK_R_APB0>,
				 <&hosc>,
				 <&rtc CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;

			/omit-if-no-ref/
			s_i2c0_pl01_pins: s-i2c0-pl01-pins {
				pins = "PL0", "PL1";
				allwinner,pinmux = <2>;
				function = "s_i2c0";
			};
		};

		ppu: power-controller@7060000 {
			compatible = "allwinner,sun60i-a733-pck-600";
			reg = <0x07060000 0xB000>;
			clocks = <&s_prcm CLK_BUS_R_PPU>;
			#power-domain-cells = <1>;
		};

		s_uart0: serial@7080000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x7080000 0x400>;
			interrupts = <GIC_SPI 201 IRQ_TYPE_LEVEL_HIGH>;
			reg-shift = <2>;
			reg-io-width = <4>;
			clocks = <&s_prcm CLK_BUS_R_UART0>;
			resets = <&s_prcm RST_BUS_R_UART0>;
//			dmas = <&dma 50>, <&dma 50>;
//			dma-names = "tx", "rx";
			status = "disabled";
		};

		s_uart1: serial@7081000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x7081000 0x400>;
			interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_HIGH>;
			reg-shift = <2>;
			reg-io-width = <4>;
			clocks = <&s_prcm CLK_BUS_R_UART1>;
			resets = <&s_prcm RST_BUS_R_UART1>;
//			dmas = <&dma 51>, <&dma 51>;
//			dma-names = "tx", "rx";
			status = "disabled";
		};

		s_twi0: i2c@7083000 {
			compatible = "allwinner,sun60i-a733-i2c",
				     "allwinner,sun8i-v536-i2c",
				     "allwinner,sun6i-a31-i2c";
			reg = <0x7083000 0x400>;
			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s_prcm CLK_BUS_R_I2C0>;
			resets = <&s_prcm RST_BUS_R_I2C0>;
//			dmas = <&dma 47>, <&dma 47>;
//			dma-names = "rx", "tx";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		s_twi1: i2c@7084000 {
			compatible = "allwinner,sun60i-a733-i2c",
				     "allwinner,sun8i-v536-i2c",
				     "allwinner,sun6i-a31-i2c";
			reg = <0x7084000 0x400>;
			interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s_prcm CLK_BUS_R_I2C1>;
			resets = <&s_prcm RST_BUS_R_I2C1>;
//			dmas = <&dma 48>, <&dma 48>;
//			dma-names = "rx", "tx";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		s_twi2: i2c@7085000 {
			compatible = "allwinner,sun60i-a733-i2c",
				     "allwinner,sun8i-v536-i2c",
				     "allwinner,sun6i-a31-i2c";
			reg = <0x7085000 0x400>;
			interrupts = <GIC_SPI 205 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s_prcm CLK_BUS_R_I2C2>;
			resets = <&s_prcm RST_BUS_R_I2C2>;
//			dmas = <&dma 49>, <&dma 49>;
//			dma-names = "rx", "tx";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		rtc: rtc@7090000 {
			compatible = "allwinner,sun60i-a733-rtc",
				     "allwinner,sun50i-r329-rtc";
			reg = <0x7090000 0x400>;
			interrupts = <GIC_SPI 196 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s_prcm CLK_BUS_R_RTC>,
				 <&hosc>,
				 <&s_prcm CLK_R_AHB>;
			clock-names = "bus", "hosc", "ahb";
			#clock-cells = <1>;
		};

		s_spi: spi@7092000 {
			compatible = "allwinner,sun60i-a733-spi",
				     "allwinner,sun55i-a523-spi";
			reg = <0x7092000 0x1000>;
			interrupts = <GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s_prcm CLK_BUS_R_SPI>, <&s_prcm CLK_R_SPI>;
			clock-names = "ahb", "mod";
			/* dmas = <&dma 54>, <&dma 54>; */
			/* dma-names = "rx", "tx"; */
			resets = <&s_prcm RST_BUS_R_SPI>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};
